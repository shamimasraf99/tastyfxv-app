<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background"
    tools:context=".MainActivity">

    <!-- 1. Main WebView Container with Pull-to-Refresh -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- 2. Top Page Navigation Progress Bar (visible after splash fades out) -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/topProgressBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:indeterminate="false"
        android:max="100"
        android:visibility="gone"
        app:indicatorColor="@color/tasty_primary"
        app:trackColor="@android:color/transparent"
        app:trackThickness="3dp" />

    <!-- 3. Clean Offline / No Internet Connection Retry Screen -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/offlineLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface_background"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="32dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="400dp">

            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_offline_circle">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/offline_icon_description"
                    android:src="@drawable/ic_wifi_off" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvOfflineTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="@string/offline_title"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOfflineSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="@string/offline_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:minWidth="180dp"
                android:minHeight="52dp"
                android:paddingHorizontal="28dp"
                android:text="@string/retry_connection"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/tasty_primary"
                app:cornerRadius="26dp"
                app:icon="@drawable/ic_refresh"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/white" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 4. Custom Splash / Loading Screen Overlay -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/splashLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/splash_background"
        android:clickable="true"
        android:elevation="12dp"
        android:focusable="true"
        android:visibility="visible">

        <!-- Center Logo & Smooth Indeterminate Loading Indicator -->
        <LinearLayout
            android:id="@+id/splashCenterGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toTopOf="@id/creditContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:layout_width="176dp"
                android:layout_height="176dp">

                <View
                    android:layout_width="176dp"
                    android:layout_height="176dp"
                    android:background="@drawable/bg_splash_glow" />

                <ImageView
                    android:id="@+id/ivSplashLogo"
                    android:layout_width="128dp"
                    android:layout_height="128dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/app_logo_description"
                    android:scaleType="fitCenter"
                    android:src="@drawable/app_logo" />
            </FrameLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/splashProgressBar"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:indeterminate="true"
                app:indicatorColor="@color/tasty_primary"
                app:trackColor="@color/tasty_primary_light"
                app:trackCornerRadius="4dp"
                app:trackThickness="4dp" />

            <TextView
                android:id="@+id/tvSplashStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:letterSpacing="0.02"
                android:text="@string/splash_loading_text"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Bottom Pinned Bengali Developer Credits -->
        <LinearLayout
            android:id="@+id/creditContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/tvCreditDeveloper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/developer_credit_line_1"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="normal" />

            <TextView
                android:id="@+id/tvCreditTelegram"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_telegram_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="48dp"
                android:paddingHorizontal="18dp"
                android:paddingVertical="10dp"
                android:text="@string/developer_credit_line_2"
                android:textColor="@color/telegram_blue"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 5. Interactive Preview Simulator Trigger (toggleable in MainActivity.kt) -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabPreviewSimulator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="@string/preview_lab_button"
        android:elevation="16dp"
        android:text="@string/preview_lab_button"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="13sp"
        app:backgroundTint="@color/text_primary"
        app:icon="@drawable/ic_tune"
        app:iconTint="@color/white" />

</FrameLayout>
